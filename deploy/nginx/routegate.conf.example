server {
    listen 80;
    listen [::]:80;

    server_name routegate.example.com;

    root /var/www/routegate;
    index index.html;

    server_tokens off;
    client_max_body_size 1m;

    # Conservative browser hardening. HSTS is only honored by browsers over
    # HTTPS; Certbot upgrades this server during the clean-host installation.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    # Access links are bearer secrets in the URL path. Never forward even
    # the Manager origin as a referrer from this host.
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "base-uri 'self'; frame-ancestors 'self'; object-src 'none'" always;

    # Commit-addressed Agent bootstrap artifacts are static release files.
    # Serve them directly and never fall back to the SPA entry point.
    location ^~ /bootstrap/ {
        root /var/www/routegate;
        try_files $uri =404;
        default_type application/octet-stream;
        add_header Cache-Control "no-store";
    }

    # Subscription URLs contain bearer credentials in the path. Proxy them
    # directly to Manager and never persist the token-bearing request URI in
    # the default nginx access log.
    location /sub/ {
        access_log off;
        # Manager already emits no-referrer. Suppress the upstream copy so
        # nginx returns exactly one consistent site-wide no-referrer policy.
        # This keeps inherited HSTS, CSP, X-Frame and nosniff headers intact.
        proxy_hide_header Referrer-Policy;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location /api/ {
        # Avoid duplicate, possibly conflicting policies from sensitive API
        # handlers. The server-level no-referrer header remains inherited.
        proxy_hide_header Referrer-Policy;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Hybrid Hysteria2 keeps a separate ACME account and certificate. Requests for
# its dedicated DNS hostname do not match the RouteGate Manager server_name and
# land here. Only the HTTP-01 challenge path is forwarded; this server never
# exposes the Manager application or certificate private key.
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        access_log off;
        proxy_pass http://127.0.0.1:9080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
    }

    location / {
        return 404;
    }
}
